@page
@model TechNews.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // Standalone layout
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechNews Admin</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 selection:bg-[#2563eb] selection:text-white">

    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-[450px] overflow-hidden relative z-10 border border-slate-100 p-8 pt-10 pb-10">
        
        <div class="mb-8 text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-50 text-[#2563eb] mb-5 shadow-inner">
                <i class="bi bi-shield-lock-fill text-2xl"></i>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 mb-2">Đăng nhập</h1>
            <p class="text-slate-500 text-sm">TechNews xin chào! Hãy đăng nhập để trải nghiệm.</p>
        </div>

        <div class="absolute top-6 right-6 text-sm font-medium text-slate-400 hover:text-slate-600 transition">
            <a href="/"><i class="bi bi-x-lg text-lg"></i></a>
        </div>

        <div class="w-full mx-auto">
            <!-- Standard Email Login -->
            <form id="account" method="post" class="space-y-4 relative">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg border border-red-100 text-center mb-4"></div>

                <div>
                    <label asp-for="Input.Email" class="block text-sm font-semibold text-slate-700 mb-1.5 pl-1">Email</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="bi bi-envelope text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                        </div>
                        <input asp-for="Input.Email" class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none" placeholder="admin@technews.vn" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1.5 pl-1 block font-medium"></span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1.5 px-1">
                        <label asp-for="Input.Password" class="block text-sm font-semibold text-slate-700">Mật khẩu</label>
                        <a href="/Identity/Account/ForgotPassword" class="text-sm font-bold text-[#2563eb] hover:text-blue-800 transition-colors">Quên mật khẩu?</a>
                    </div>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="bi bi-lock text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                        </div>
                        <input asp-for="Input.Password" type="password" class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none tracking-widest" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1.5 pl-1 block font-medium"></span>
                </div>

                <div class="flex items-center pt-2">
                    <div class="flex items-center group cursor-pointer">
                        <input asp-for="Input.RememberMe" id="remember-me" type="checkbox" class="h-4 w-4 text-[#2563eb] focus:ring-[#2563eb] border-slate-300 rounded cursor-pointer transition-colors" />
                        <label for="remember-me" class="ml-2.5 block text-sm text-slate-600 font-medium cursor-pointer group-hover:text-slate-900 transition-colors">Duy trì đăng nhập</label>
                    </div>
                </div>

                <button type="submit" class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-[0_4px_14px_0_rgba(37,99,235,0.39)] hover:shadow-[0_6px_20px_rgba(37,99,235,0.23)] hover:bg-[#1d4ed8] text-sm font-bold text-white bg-[#2563eb] focus:outline-none focus:ring-4 focus:ring-[#2563eb]/50 transition-all duration-300 mt-2">
                    <span>Đăng nhập ngay</span> <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="relative flex items-center flex-col my-7">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-slate-200"></div>
                </div>
                <div class="relative bg-white px-4 text-[11px] tracking-wider text-slate-400 font-bold uppercase">
                    Hoặc kết nối qua
                </div>
            </div>

            <!-- External Logins -->
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="flex gap-3">
                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <button type="button" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 border border-slate-200 rounded-xl shadow-sm bg-white text-sm font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all">
                        <i class="bi bi-google text-red-500 text-lg"></i> Google
                    </button>
                    <button type="button" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 border border-slate-200 rounded-xl shadow-sm bg-white text-sm font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all">
                        <i class="bi bi-facebook text-[#1877f2] text-lg"></i> Facebook
                    </button>
                }
                else
                {
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button type="submit" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 border border-slate-200 rounded-xl shadow-sm bg-white text-sm font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all" name="provider" value="@provider.Name" title="Đăng nhập bằng @provider.DisplayName">
                            @if (provider.Name == "Google") { <i class="bi bi-google text-red-500 text-lg"></i> }
                            else if (provider.Name == "Facebook") { <i class="bi bi-facebook text-[#1877f2] text-lg"></i> }
                            else { <i class="bi bi-shield-lock text-slate-500 text-lg"></i> }
                            @provider.DisplayName
                        </button>
                    }
                }
            </form>

            <div class="mt-8 text-center bg-slate-50 rounded-xl p-4 border border-slate-100">
                <p class="text-sm font-medium text-slate-500">
                    Chưa có tài khoản? 
                    <a href="/Identity/Account/Register" class="font-bold text-[#2563eb] hover:text-blue-800 ml-1 hover:underline transition-colors">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('account');
            const inputs = form.querySelectorAll('input');
            inputs.forEach(input => {
                input.addEventListener('keypress', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        form.submit();
                    }
                });
            });
        });
    </script>
</body>
</html>
