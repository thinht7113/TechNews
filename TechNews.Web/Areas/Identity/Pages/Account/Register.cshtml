@page
@model TechNews.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechNews</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4 selection:bg-[#2563eb] selection:text-white">

    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-[450px] overflow-hidden relative z-10 border border-slate-100 p-8 pt-10 pb-10">
        
        <div class="mb-6 text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-50 text-[#2563eb] mb-5 shadow-inner">
                <i class="bi bi-person-plus-fill text-2xl"></i>
            </div>
            <h1 class="text-3xl font-extrabold text-slate-900 mb-2">Đăng ký</h1>
            <p class="text-slate-500 text-sm">Trở thành thành viên của cộng đồng TechNews.</p>
        </div>

        <div class="absolute top-6 right-6 text-sm font-medium text-slate-400 hover:text-slate-600 transition">
            <a href="/"><i class="bi bi-x-lg text-lg"></i></a>
        </div>

        <div class="w-full mx-auto">
            <!-- Registration Form -->
            <form id="account" method="post" class="space-y-4 relative">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 p-3 rounded-lg border border-red-100 text-center mb-4"></div>

                <div>
                    <label asp-for="Input.FullName" class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Họ và tên</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="bi bi-person text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                        </div>
                        <input asp-for="Input.FullName" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none" placeholder="Nguyễn Văn A" />
                    </div>
                    <span asp-validation-for="Input.FullName" class="text-red-500 text-xs mt-1 pl-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="Input.Email" class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Email</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="bi bi-envelope text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                        </div>
                        <input asp-for="Input.Email" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none" placeholder="admin@technews.vn" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 pl-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="Input.Password" class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Mật khẩu</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="bi bi-lock text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                        </div>
                        <input asp-for="Input.Password" type="password" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none tracking-widest" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 pl-1 block font-medium"></span>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Xác nhận mật khẩu</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                            <i class="bi bi-shield-check text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                        </div>
                        <input asp-for="Input.ConfirmPassword" type="password" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none tracking-widest" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs mt-1 pl-1 block font-medium"></span>
                </div>

                <button type="submit" class="w-full flex justify-center items-center gap-2 py-3 px-4 rounded-xl shadow-[0_4px_14px_0_rgba(37,99,235,0.39)] hover:shadow-[0_6px_20px_rgba(37,99,235,0.23)] hover:bg-[#1d4ed8] text-sm font-bold text-white bg-[#2563eb] focus:outline-none focus:ring-4 focus:ring-[#2563eb]/50 transition-all duration-300 mt-2">
                    <span>Đăng ký ngay</span> <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="mt-8 text-center bg-gray-50 rounded-xl p-4 border border-slate-100">
                <p class="text-sm font-medium text-slate-500">
                    Đã có tài khoản? 
                    <a href="/Identity/Account/Login" class="font-bold text-[#2563eb] hover:text-blue-800 ml-1 hover:underline transition-colors">Đăng nhập</a>
                </p>
            </div>
        </div>
    </div>

</body>
</html>
