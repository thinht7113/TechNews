@model IEnumerable<TechNews.Domain.Entities.Post>
@{
    ViewData["Title"] = "Tin đã lưu";
    Layout = "_ProfileLayout";
}

<div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-100">
    <h1 class="text-2xl font-bold text-slate-800">Tin đã lưu</h1>
    <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">@ViewBag.TotalCount bài viết</span>
</div>

@if (!Model.Any())
{
    <div class="text-center py-12 text-slate-500">
        <i class="bi bi-bookmark text-4xl mb-3 block text-slate-300"></i>
        <p>Bạn chưa lưu bài viết nào.</p>
        <a href="/" class="inline-block mt-4 text-[#2563eb] hover:underline">Khám phá tin tức</a>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @foreach (var post in Model)
        {
            <a href="/post/@post.Slug" class="group bg-white rounded-xl border border-gray-100 overflow-hidden hover:shadow-soft transition-all duration-300">
                <div class="relative max-h-[160px] overflow-hidden">
                    <img src="@post.Thumbnail" alt="@post.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='/images/placeholder.jpg'" />
                    <div class="absolute top-3 left-3 bg-[#2563eb]/90 text-white text-[10px] font-bold px-2.5 py-1 rounded-md uppercase tracking-wide backdrop-blur-sm z-10">
                        @post.Category?.Name
                    </div>
                </div>
                <div class="p-4">
                    <h3 class="font-bold text-slate-900 group-hover:text-[#2563eb] transition-colors line-clamp-2 mb-2">@post.Title</h3>
                    <p class="text-sm text-slate-500 line-clamp-2 mb-4">@post.ShortDescription</p>
                    <div class="flex items-center text-[11px] text-slate-400 font-medium">
                        <i class="bi bi-clock mr-1.5"></i> @post.CreatedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </a>
        }
    </div>

    @if (ViewBag.TotalCount > 12)
    {
        <div class="mt-8 flex justify-center">
            <a href="?page=@(ViewBag.CurrentPage + 1)" class="px-5 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-[#2563eb] hover:text-white transition-colors text-sm font-medium">
                Tải thêm
            </a>
        </div>
    }
}
