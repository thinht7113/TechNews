@model IEnumerable<TechNews.Domain.Entities.Comment>
@{
    ViewData["Title"] = "Ý kiến của bạn";
    Layout = "_ProfileLayout";
}

<div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-100">
    <h1 class="text-2xl font-bold text-slate-800">Ý kiến của bạn</h1>
    <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">@ViewBag.TotalCount ý kiến</span>
</div>

@if (!Model.Any())
{
    <div class="text-center py-12 text-slate-500">
        <i class="bi bi-chat-square-text text-4xl mb-3 block text-slate-300"></i>
        <p>Bạn chưa gửi bình luận nào.</p>
    </div>
}
else
{
    <div class="space-y-6">
        @foreach (var c in Model)
        {
            <div class="bg-slate-50 rounded-xl p-5 border border-slate-100 hover:shadow-soft hover:border-[#2563eb]/20 transition-all group">
                <div class="flex items-start justify-between gap-4 mb-3">
                    <a href="/post/@c.Post?.Slug#comments" class="font-bold text-slate-800 line-clamp-1 hover:text-[#2563eb] transition-colors flex-1">
                        @c.Post?.Title
                    </a>
                    @if (c.IsApproved)
                    {
                        <span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wide shrink-0">Đã duyệt</span>
                    }
                    else
                    {
                        <span class="bg-amber-100 text-amber-700 text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wide shrink-0">Chờ duyệt</span>
                    }
                </div>
                
                <p class="text-sm text-slate-600 mb-3 bg-white p-3 rounded-lg border border-slate-100">
                    "@c.Content"
                </p>
                
                <div class="flex items-center text-xs text-slate-400 font-medium">
                    <i class="bi bi-clock mr-1.5"></i> @c.CreatedDate.ToString("HH:mm - dd/MM/yyyy")
                </div>
            </div>
        }
    </div>
    
    @* Phân trang đơn giản (nếu rảnh có thể làm Component) *@
    @if (ViewBag.TotalCount > 10)
    {
        <div class="mt-8 flex justify-center">
            <a href="?page=@(ViewBag.CurrentPage + 1)" class="px-5 py-2 bg-slate-100 text-slate-600 rounded-lg hover:bg-[#2563eb] hover:text-white transition-colors text-sm font-medium">
                Tải thêm
            </a>
        </div>
    }
}
