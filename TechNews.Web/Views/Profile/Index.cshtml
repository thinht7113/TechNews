@model TechNews.Domain.Entities.User
@{
    ViewData["Title"] = "Thông tin chung";
    Layout = "_ProfileLayout";
}

<div class="flex items-center justify-between mb-8 pb-4 border-b border-gray-100">
    <h1 class="text-2xl font-bold text-slate-800">Thông tin chung</h1>
</div>

<div class="max-w-xl">
    <div class="flex items-center gap-6 mb-8">
        <div class="relative w-24 h-24 rounded-full bg-[#1d4ed8] text-white flex items-center justify-center font-bold text-4xl shadow-soft shrink-0">
            @if(string.IsNullOrEmpty(Model.Avatar)) {
                <span>@(Model.Email?.FirstOrDefault().ToString().ToUpper() ?? "U")</span>
            } else {
                <img src="@Model.Avatar" alt="Avatar" class="w-full h-full rounded-full object-cover" />
            }
        </div>
        <div>
            <h2 class="text-xl font-bold text-slate-900 mb-1">@(Model.FullName ?? Model.UserName?.Split('@')[0])</h2>
            <p class="text-sm text-slate-500 font-mono">@Model.Email</p>
            <p class="text-xs text-slate-400 mt-2">Tham gia ngày: @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <form method="post" action="/Identity/Account/Manage" class="space-y-6">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tên hiển thị</label>
            <input type="text" value="@(Model.FullName ?? Model.UserName?.Split('@')[0])" class="w-full bg-slate-50 border border-slate-200 rounded-lg px-4 py-2.5 text-sm focus:bg-white focus:border-[#2563eb] focus:ring-2 focus:ring-[#2563eb]/20 outline-none transition-all disabled:opacity-70 disabled:bg-gray-100" disabled />
            <p class="text-xs text-amber-600 mt-1 italic">Vui lòng cập nhật tên và mật khẩu tại phần Quản lý tài khoản gốc (Identity).</p>
        </div>
        
        <div class="pt-4 flex gap-4">
            <a href="/Identity/Account/Manage" class="px-6 py-2.5 bg-[#2563eb] text-white font-medium rounded-lg hover:bg-[#1d4ed8] hover:shadow-glow transition-all text-sm flex items-center gap-2">
                <i class="bi bi-pencil-square"></i> Sửa thông tin
            </a>
            <a href="/Identity/Account/Manage/ChangePassword" class="px-6 py-2.5 bg-slate-100 text-slate-700 font-medium rounded-lg hover:bg-slate-200 transition-all text-sm flex items-center gap-2">
                <i class="bi bi-key"></i> Đổi mật khẩu
            </a>
        </div>
    </form>
</div>
