@model List<TechNews.Domain.Entities.Category>

<h4 class="font-bold text-gray-900 text-lg mb-6">Chuyên mục</h4>
<ul class="space-y-3 text-sm">
    @foreach (var c in Model)
    {
        <li>
            <a href="/category/@c.Slug" class="hover:text-primary transition-colors flex items-center gap-2">
                <i class="bi bi-chevron-right text-xs"></i> @c.Name
            </a>
        </li>
    }
</ul>
