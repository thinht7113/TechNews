@using Microsoft.AspNetCore.Identity
@using TechNews.Domain.Entities
@inject SignInManager<User> SignInManager
@inject TechNews.Infrastructure.Data.TechNewsDbContext _db
@{
    var _settings = _db.Settings.ToDictionary(s => s.Key, s => s.Value ?? "");
    string _get(string key, string fallback = "") => _settings.ContainsKey(key) && !string.IsNullOrEmpty(_settings[key]) ? _settings[key] : fallback;
    var _siteTitle = _get("SiteTitle", "TechNews");
    var _contactEmail = _get("ContactEmail", "contact@technews.com");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2563eb',
                        secondary: '#757575',
                        dark: '#0f172a',
                        light: '#f8fafc',
                        surface: '#ffffff'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'], 
                        serif: ['Merriweather', 'serif'],
                    },
                    boxShadow: {
                        'soft': '0 10px 40px -10px rgba(0, 0, 0, 0.08)',
                        'glow': '0 0 20px rgba(37, 99, 235, 0.4)',
                    }
                }
            }
        }
    </script>
    <!-- Frameworks -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    
    <style>
        [x-cloak] { display: none !important; }
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .font-serif { font-family: 'Merriweather', serif; }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        .glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .nav-link { 
            position: relative;
            font-weight: 600; 
            color: #334155; 
            transition: color 0.3s;
        }
        .nav-link:hover { color: #2563eb; }
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background-color: #2563eb;
            transition: width 0.3s;
        }
        .nav-link:hover::after { width: 100%; }
        
        .container-custom { max-w: 1280px; margin: 0 auto; padding: 0 1.5rem; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen" x-data="{ loginModalOpen: false, registerModalOpen: false }">

    <!-- Glass Header -->
    <header class="fixed top-0 left-0 w-full z-50 glass transition-all duration-300" 
            x-data="{ mobileMenuOpen: false, scrolled: false }"
            @@scroll.window="scrolled = (window.pageYOffset > 20)"
            :class="{ 'shadow-soft': scrolled }">
            
        <div class="container-custom h-[80px] flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2 group">
                <div class="relative w-10 h-10 bg-[#2563eb] text-white flex items-center justify-center font-bold text-2xl rounded-xl shadow-glow transition-transform group-hover:scale-105 group-hover:rotate-3">
                    @_siteTitle[0]
                    <div class="absolute inset-0 rounded-xl bg-white opacity-20 blur-sm"></div>
                </div>
                <div class="flex flex-col leading-none">
                    <span class="text-2xl font-extrabold tracking-tight text-slate-900 group-hover:text-[#2563eb] transition-colors">@_siteTitle</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden lg:flex items-center gap-2">
                @{
                    var currentUrl = Context.Request.Path.Value;
                    var isHome = string.IsNullOrEmpty(currentUrl) || currentUrl == "/";
                    
                    var today = DateTime.Now.ToString("dddd, d/M/yyyy", new System.Globalization.CultureInfo("vi-VN"));
                    if (!string.IsNullOrEmpty(today) && char.IsLower(today[0]))
                    {
                        today = char.ToUpper(today[0]) + today.Substring(1);
                    }
                }
                <span class="text-[14px] text-slate-500 font-medium border-l border-slate-200 pl-6 mr-2">@today</span>
                <a href="/" class="nav-link px-4 py-2 rounded-full transition-all duration-300 @(isHome ? "bg-[#2563eb]/10 text-[#2563eb] font-semibold shadow-[0_2px_10px_-3px_rgba(37,99,235,0.2)]" : "text-slate-600 font-medium hover:bg-slate-100/80 hover:text-slate-900")">Trang chủ</a>
                 @await Component.InvokeAsync("Menu")
            </nav>

            <!-- Search & Actions -->
            <div class="flex items-center gap-4">
                <div class="relative hidden lg:block group">
                    <form action="/post/search" method="get">
                        <input type="text" name="query" placeholder="Tìm kiếm..." 
                               class="bg-slate-100 border border-transparent rounded-full pl-4 pr-10 py-2 text-sm w-48 focus:w-64 focus:bg-white focus:border-[#2563eb]/30 focus:shadow-soft outline-none transition-all duration-300" />
                        <button type="submit" class="absolute right-3 top-2 text-slate-400 hover:text-[#2563eb] transition-colors">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="hidden md:flex items-center pl-4 border-l border-slate-200">
                        <div x-data="{ openUserMenu: false }" class="relative">
                            <button @@click="openUserMenu = !openUserMenu" @@click.away="openUserMenu = false" class="flex items-center gap-2 focus:outline-none hover:bg-slate-50 px-2 py-1.5 rounded-lg transition-colors">
                                <div class="w-8 h-8 rounded-full bg-[#1d4ed8] text-white flex items-center justify-center font-bold text-sm shadow-soft">
                                    @(User.Identity.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                </div>
                                <span class="text-sm font-medium text-slate-700">@(User.Identity.Name?.Split('@')[0])</span>
                                <i class="bi bi-chevron-down text-[10px] text-slate-400"></i>
                            </button>

                            <!-- Dropdown Menu -->
                            <div x-show="openUserMenu" style="display: none;"
                                 x-transition:enter="transition ease-out duration-100"
                                 x-transition:enter-start="transform opacity-0 scale-95"
                                 x-transition:enter-end="transform opacity-100 scale-100"
                                 x-transition:leave="transition ease-in duration-75"
                                 x-transition:leave-start="transform opacity-100 scale-100"
                                 x-transition:leave-end="transform opacity-0 scale-95"
                                 class="absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] border border-gray-100 py-2 z-50">
                                
                                <div class="px-4 py-3 border-b border-gray-100 mb-1 bg-slate-50/50 rounded-t-xl -mt-2">
                                    <p class="text-sm font-bold text-gray-900 truncate">@(User.Identity.Name?.Split('@')[0])</p>
                                    <p class="text-xs text-gray-500 truncate">@User.Identity.Name</p>
                                </div>
                                
                                <a href="/Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-slate-50 hover:text-[#2563eb] transition-colors"><i class="bi bi-person mr-2"></i> Thông tin chung</a>
                                <a href="/Profile/Comments" class="block px-4 py-2 text-sm text-gray-700 hover:bg-slate-50 hover:text-[#2563eb] transition-colors"><i class="bi bi-chat-left-text mr-2"></i> Ý kiến của bạn</a>
                                <a href="/Profile/Saved" class="block px-4 py-2 text-sm text-gray-700 hover:bg-slate-50 hover:text-[#2563eb] transition-colors"><i class="bi bi-bookmark mr-2"></i> Tin đã lưu</a>
                                <a href="/Profile/History" class="block px-4 py-2 text-sm text-gray-700 hover:bg-slate-50 hover:text-[#2563eb] transition-colors"><i class="bi bi-clock-history mr-2"></i> Tin đã xem</a>
                                
                                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                                {
                                    <div class="border-t border-gray-100 my-1"></div>
                                    <a href="/Admin" class="flex items-center px-4 py-2 text-sm font-medium text-[#2563eb] hover:bg-slate-50 transition-colors">
                                        <i class="bi bi-grid-fill mr-2"></i> Quản lý
                                    </a>
                                }
                                
                                <div class="border-t border-gray-100 my-1"></div>
                                <form class="w-full m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                    <button type="submit" class="w-full flex items-center text-left px-4 py-2 text-sm text-red-600 font-medium hover:bg-red-50 transition-colors focus:outline-none">
                                        <i class="bi bi-box-arrow-right mr-2 text-lg leading-none"></i> Thoát
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                     <button @@click="loginModalOpen = true" class="hidden md:inline-flex items-center gap-2 px-5 py-2 rounded-full bg-slate-900 text-white text-sm font-semibold hover:bg-[#2563eb] hover:shadow-glow transition-all duration-300">
                        Đăng nhập
                    </button>
                }

                <!-- Mobile Menu Button -->
                <button @@click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden text-2xl text-slate-700 hover:text-[#2563eb] transition-colors">
                    <i class="bi" :class="mobileMenuOpen ? 'bi-x-lg' : 'bi-list'"></i>
                </button>
            </div>
        </div>
        
        <!-- Mobile Menu Dropdown -->
        <div x-show="mobileMenuOpen" 
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-2"
             x-transition:enter-end="opacity-100 translate-y-0"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 translate-y-0"
             x-transition:leave-end="opacity-0 -translate-y-2"
             class="md:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100 p-6 shadow-xl absolute w-full left-0 top-full z-40 h-[calc(100vh-80px)] overflow-y-auto">
             
             <nav class="flex flex-col space-y-2 text-lg font-medium">
                <a href="/" class="block px-4 py-3 rounded-xl transition-colors @(isHome ? "bg-[#2563eb]/10 text-[#2563eb] font-bold" : "text-slate-600 hover:bg-slate-50 hover:text-[#2563eb]")">Trang chủ</a>
                 @await Component.InvokeAsync("Menu")
                 
                 <div class="pt-6 border-t border-gray-100">
                      @if (User.Identity!.IsAuthenticated)
                        {
                            <div class="flex items-center justify-between">
                                <span class="text-slate-500">Xin chào, @(User.Identity.Name?.Split('@')[0])</span>
                                <div class="flex gap-2">
                                     @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                                     {
                                         <a href="/Admin" class="text-[#2563eb] font-bold">Trang quản trị</a>
                                     }
                                     <form class="inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                                         <button type="submit" class="text-slate-500 hover:text-slate-800">Đăng xuất</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                             <button @@click="loginModalOpen = true; mobileMenuOpen = false" class="block w-full text-center py-3 rounded-xl bg-slate-900 text-white font-bold hover:bg-[#2563eb] transition">
                                Đăng nhập
                            </button>
                        }
                 </div>
            </nav>
        </div>
    </header>

    <!-- Spacer for Fixed Header -->
    <div class="h-[80px]"></div>



    <!-- Main Content -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white text-gray-600 py-12 mt-20 font-sans border-t border-gray-200 relative overflow-hidden">
        <!-- Background Decor -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-orange-500 to-primary"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-primary opacity-5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="container-custom mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-10">
                @await Component.InvokeAsync("SiteSettings")

                <!-- Links 1 -->
                <div>
                    @await Component.InvokeAsync("FooterCategories")
                </div>

                 <!-- Links 2 -->
                <div>
                    @await Component.InvokeAsync("FooterStaticPages")
                </div>

                <!-- Newsletter -->
                <div>
                    <h4 class="font-bold text-gray-900 text-lg mb-6">Đăng ký nhận tin</h4>
                    <p class="text-gray-500 text-sm mb-4">Nhận thông báo về bài viết mới nhất qua email.</p>
                    <form id="newsletterForm" class="flex flex-col gap-3">
                        <input id="newsletterEmail" type="email" placeholder="Email của bạn..." required
                               class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 w-full text-gray-900 focus:border-primary focus:ring-1 focus:ring-primary outline-none text-sm transition-all" />
                        <button type="submit" id="newsletterBtn"
                                class="bg-primary text-white px-6 py-3 rounded-lg font-bold hover:bg-opacity-90 transition-opacity shadow-lg text-sm uppercase tracking-wide">
                            Đăng ký ngay
                        </button>
                    </form>
                    <p id="newsletterMsg" class="mt-3 text-sm hidden"></p>
                </div>
            </div>

            <div class="border-t border-gray-200 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
                <p>&copy; 2026 @_siteTitle. All rights reserved.</p>
                <div class="flex gap-6 mt-4 md:mt-0">
                    <a href="/Home/Privacy" class="hover:text-primary transition-colors">Chính sách bảo mật</a>
                    <a href="/Home/Contact" class="hover:text-primary transition-colors">Liên hệ</a>
                    <span class="flex items-center gap-1"><i class="bi bi-geo-alt-fill"></i> Hà Nội, Việt Nam</span>
                    <span class="flex items-center gap-1"><i class="bi bi-envelope-fill"></i> @_contactEmail</span>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.getElementById('newsletterForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const email = document.getElementById('newsletterEmail').value.trim();
            const btn = document.getElementById('newsletterBtn');
            const msg = document.getElementById('newsletterMsg');

            if (!email) return;

            btn.disabled = true;
            btn.textContent = 'Đang gửi...';
            msg.className = 'mt-3 text-sm hidden';

            try {
                const res = await fetch('/api/newsletter/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const data = await res.json();

                msg.textContent = data.message || (res.ok ? 'Đăng ký thành công!' : 'Có lỗi xảy ra');
                msg.className = res.ok
                    ? 'mt-3 text-sm text-green-600 font-medium'
                    : 'mt-3 text-sm text-red-600 font-medium';

                if (res.ok) document.getElementById('newsletterEmail').value = '';
            } catch {
                msg.textContent = 'Lỗi kết nối. Vui lòng thử lại.';
                msg.className = 'mt-3 text-sm text-red-600 font-medium';
            } finally {
                btn.disabled = false;
                btn.textContent = 'Đăng ký ngay';
            }
        });
    </script>
    
    <!-- Login Modal -->
    <div x-show="loginModalOpen" x-cloak class="relative z-[100]" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="loginModalOpen"
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="loginModalOpen = false"></div>

        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0 pointer-events-none">
                
                <div x-show="loginModalOpen"
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:my-8 w-full max-w-[450px] pointer-events-auto border border-slate-100">
                    
                    <button @@click="loginModalOpen = false" class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 transition-colors z-10 bg-slate-50 hover:bg-slate-100 rounded-full w-8 h-8 flex items-center justify-center">
                        <i class="bi bi-x-lg text-sm"></i>
                    </button>

                    <div class="px-8 pt-10 pb-8 flex flex-col justify-center bg-white relative">

                        <div class="mb-8 text-center">
                            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-50 text-[#2563eb] mb-5 shadow-inner">
                                <i class="bi bi-shield-lock-fill text-2xl"></i>
                            </div>
                            <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Đăng nhập</h3>
                            <p class="text-slate-500 text-sm">TechNews xin chào! Hãy đăng nhập để trải nghiệm.</p>
                        </div>

                        <!-- Email Login -->
                        <form id="loginFormElement" class="space-y-4 relative" onsubmit="return false;">

                            <div>
                                <label class="block text-sm font-semibold text-slate-700 mb-1.5 pl-1">Email</label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                        <i class="bi bi-envelope text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                                    </div>
                                    <input id="loginEmail" type="email" required class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none" placeholder="admin@technews.vn" />
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1.5 px-1">
                                    <label class="block text-sm font-semibold text-slate-700">Mật khẩu</label>
                                    <a href="/Identity/Account/ForgotPassword" class="text-xs font-bold text-[#2563eb] hover:text-blue-800 transition-colors">Quên mật khẩu?</a>
                                </div>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                        <i class="bi bi-lock text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                                    </div>
                                    <input id="loginPassword" type="password" required class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none tracking-widest" placeholder="••••••••" />
                                </div>
                            </div>

                            <div class="flex items-center pt-2">
                                <div class="flex items-center group cursor-pointer">
                                    <input id="loginRememberMe" type="checkbox" class="h-4 w-4 text-[#2563eb] focus:ring-[#2563eb] border-slate-300 rounded cursor-pointer transition-colors" />
                                    <label for="loginRememberMe" class="ml-2.5 block text-sm text-slate-600 font-medium cursor-pointer group-hover:text-slate-900 transition-colors">Duy trì đăng nhập</label>
                                </div>
                            </div>

                            <div id="loginErrorMsg" class="hidden text-red-600 text-sm font-medium bg-red-50 p-3 rounded-xl border border-red-100 text-center"></div>
                            <div id="loginSuccessMsg" class="hidden text-green-600 text-sm font-medium bg-green-50 p-3 rounded-xl border border-green-100 text-center"></div>

                            <button type="button" id="loginSubmitBtn" onclick="doLogin()" class="w-full flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl shadow-[0_4px_14px_0_rgba(37,99,235,0.39)] hover:shadow-[0_6px_20px_rgba(37,99,235,0.23)] hover:bg-[#1d4ed8] text-sm font-bold text-white bg-[#2563eb] focus:outline-none focus:ring-4 focus:ring-[#2563eb]/50 transition-all duration-300 mt-2">
                                Đăng nhập ngay <i class="bi bi-arrow-right"></i>
                            </button>
                        </form>



                        <div class="mt-8 text-center">
                            <p class="text-sm font-medium text-slate-500">
                                Chưa có tài khoản? 
                                <button type="button" @@click="loginModalOpen = false; setTimeout(() => registerModalOpen = true, 300)" class="font-bold text-[#2563eb] hover:text-blue-800 ml-1 transition-colors">Đăng ký ngay</button>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Register Modal -->
    <div x-show="registerModalOpen" x-cloak class="relative z-[100]" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div x-show="registerModalOpen"
             x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
             x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
             class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" @@click="registerModalOpen = false"></div>

        <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0 pointer-events-none">
                
                <div x-show="registerModalOpen"
                     x-transition:enter="ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95" x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                     x-transition:leave="ease-in duration-200" x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100" x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                     class="relative transform overflow-hidden rounded-3xl bg-white text-left shadow-2xl transition-all sm:my-8 w-full max-w-[450px] pointer-events-auto border border-slate-100">
                    
                    <button @@click="registerModalOpen = false" class="absolute top-5 right-5 text-slate-400 hover:text-slate-700 transition-colors z-10 bg-slate-50 hover:bg-slate-100 rounded-full w-8 h-8 flex items-center justify-center">
                        <i class="bi bi-x-lg text-sm"></i>
                    </button>

                    <div class="px-8 pt-10 pb-8 flex flex-col justify-center bg-white relative" x-data="registerForm()">

                        <div class="mb-6 text-center">
                            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-50 text-[#2563eb] mb-5 shadow-inner">
                                <i class="bi bi-person-plus-fill text-2xl"></i>
                            </div>
                            <h3 class="text-2xl font-extrabold text-slate-900 mb-2">Đăng ký</h3>
                            <p class="text-slate-500 text-sm">Trở thành thành viên của cộng đồng TechNews.</p>
                        </div>

                        <!-- AJAX Error message -->
                        <div x-show="errorMessage" x-cloak class="text-red-600 text-[13px] font-medium bg-red-50 p-3 rounded-xl border border-red-100 text-center mb-5" x-text="errorMessage"></div>
                        <div x-show="successMessage" x-cloak class="text-[#2563eb] text-[13px] font-medium bg-blue-50 p-3 rounded-xl border border-blue-100 text-center mb-5" x-text="successMessage"></div>

                        <!-- Email Registration Form -->
                        <form @@submit.prevent="submit" class="space-y-4 relative">
                            <!-- Loading spinner overlay overlaying the form inside -->
                            <div x-show="loading" class="absolute inset-0 z-10 bg-white/80 backdrop-blur-sm flex items-center justify-center rounded-xl">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[#2563eb]"></div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Họ và tên</label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                        <i class="bi bi-person text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                                    </div>
                                    <input x-model="fullName" type="text" required class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none" placeholder="Nguyễn Văn A" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Email</label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                        <i class="bi bi-envelope text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                                    </div>
                                    <input x-model="email" type="email" required class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none" placeholder="admin@technews.vn" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Mật khẩu</label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                        <i class="bi bi-lock text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                                    </div>
                                    <input x-model="password" type="password" required minlength="6" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none tracking-widest" placeholder="••••••••" />
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1 pl-1">Xác nhận mật khẩu</label>
                                <div class="relative group">
                                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                        <i class="bi bi-shield-check text-slate-400 group-focus-within:text-[#2563eb] transition-colors"></i>
                                    </div>
                                    <input x-model="confirmPassword" type="password" required minlength="6" class="block w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-4 focus:ring-[#2563eb]/10 focus:border-[#2563eb] focus:bg-white transition-all text-sm font-medium outline-none tracking-widest" placeholder="••••••••" />
                                </div>
                            </div>

                            <button type="submit" :disabled="loading" class="w-full flex justify-center items-center gap-2 py-3 px-4 rounded-xl shadow-[0_4px_14px_0_rgba(37,99,235,0.39)] hover:shadow-[0_6px_20px_rgba(37,99,235,0.23)] hover:bg-[#1d4ed8] text-sm font-bold text-white bg-[#2563eb] focus:outline-none focus:ring-4 focus:ring-[#2563eb]/50 transition-all duration-300 mt-2">
                                <span x-text="loading ? 'Đang xử lý...' : 'Đăng ký ngay'"></span> <i class="bi bi-arrow-right" x-show="!loading"></i>
                            </button>
                        </form>

                        <div class="relative flex items-center flex-col my-6">
                            <div class="absolute inset-0 flex items-center">
                                <div class="w-full border-t border-slate-200"></div>
                            </div>
                            <div class="relative bg-white px-4 text-[11px] tracking-wider text-slate-400 font-bold uppercase">
                                Hoặc
                            </div>
                        </div>

                        <div class="text-center">
                            <p class="text-sm font-medium text-slate-500">
                                Đã có tài khoản? 
                                <button type="button" @@click="registerModalOpen = false; setTimeout(() => loginModalOpen = true, 300)" class="font-bold text-[#2563eb] hover:text-blue-800 ml-1 transition-colors">Đăng nhập</button>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function registerForm() {
            return {
                fullName: '',
                email: '',
                password: '',
                confirmPassword: '',
                loading: false,
                errorMessage: '',
                successMessage: '',
                async submit() {
                    if (this.password !== this.confirmPassword) {
                        this.errorMessage = "Mật khẩu xác nhận không khớp.";
                        return;
                    }

                    this.loading = true;
                    this.errorMessage = '';
                    this.successMessage = '';

                    try {
                        const response = await fetch('/api/auth/register', {
                            method: 'POST',
                            credentials: 'include',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                fullName: this.fullName,
                                email: this.email,
                                password: this.password,
                                confirmPassword: this.confirmPassword
                            })
                        });

                        const data = await response.json();

                        if (response.ok && data.success) {
                            this.successMessage = "Đăng ký thành công! Đang tải...";
                            setTimeout(() => {
                                window.location.href = '/';
                            }, 500);
                        } else {
                            this.errorMessage = data.message || "Đăng ký thất bại. Kiểm tra lại thông tin.";
                        }
                    } catch (error) {
                        this.errorMessage = "Có lỗi xảy ra kết nối mạng. Vui lòng thử lại.";
                    } finally {
                        this.loading = false;
                    }
                }
            }
        }

        async function doLogin() {
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;
            const rememberMe = document.getElementById('loginRememberMe').checked;
            const btn = document.getElementById('loginSubmitBtn');
            const errorDiv = document.getElementById('loginErrorMsg');
            const successDiv = document.getElementById('loginSuccessMsg');

            // Reset messages
            errorDiv.classList.add('hidden');
            errorDiv.textContent = '';
            successDiv.classList.add('hidden');
            successDiv.textContent = '';

            if (!email || !password) {
                errorDiv.textContent = 'Vui lòng nhập đầy đủ Email và Mật khẩu.';
                errorDiv.classList.remove('hidden');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span>Đang xử lý...</span>';

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password, rememberMe })
                });

                const data = await response.json();

                if (response.ok && data.success) {
                    successDiv.textContent = 'Đăng nhập thành công! Đang tải...';
                    successDiv.classList.remove('hidden');
                    setTimeout(() => { window.location.href = window.location.pathname; }, 600);
                } else {
                    errorDiv.textContent = data.message || 'Đăng nhập thất bại.';
                    errorDiv.classList.remove('hidden');
                }
            } catch (err) {
                errorDiv.textContent = 'Lỗi kết nối mạng. Vui lòng thử lại.';
                errorDiv.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Đăng nhập ngay <i class="bi bi-arrow-right"></i>';
            }
        }
    </script>
</body>
</html>
